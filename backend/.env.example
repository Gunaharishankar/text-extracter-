# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/transformo-docs

# Microservices
TIKA_SERVER_URL=http://localhost:9998
PYTHON_SERVICE_URL=http://localhost:8000
STORAGE_PROVIDER=local

# JWT Authentication
JWT_ACCESS_SECRET=your_jwt_access_secret_here_min_64_chars_recommended
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_min_64_chars_recommended
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/google/continue

# Nodemailer SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password_here
SMTP_FROM_NAME="Transformo Docs"
SMTP_FROM_EMAIL=your_email@gmail.com

# Client / Frontend URL
CLIENT_URL=http://localhost:5173
